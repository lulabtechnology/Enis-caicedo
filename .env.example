# IDX / ACOBIR RealtyServer
IDX_FTP_HOST=ftp.realtyserver.com
IDX_FTP_USER=
IDX_FTP_PASSWORD=
IDX_FTP_SECURE=false
IDX_FEEDS=res,com
IDX_ALLOWED_ZONES=Costa del Este,San Francisco,Obarrio,Bella Vista,Santa Maria
IDX_DOWNLOAD_PHOTOS=true
IDX_MAX_PHOTOS_PER_LISTING=12

# Debug opcional
IDX_FTP_VERBOSE=false
IDX_INCLUDE_RAW=false

# Control de fotos para GitHub Actions / sincronizacion larga
IDX_PHOTO_TIME_BUDGET_MINUTES=45
IDX_PHOTO_PROGRESS_EVERY=10
IDX_PHOTO_FETCH_TIMEOUT_MS=20000

# ==========================================================
# SUPABASE EXISTENTE DEL IDX - NO REEMPLAZAR POR EL DEL BLOG
# ==========================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=idx-photos

# Sitio publico
NEXT_PUBLIC_SITE_URL=https://eniscaicedo.com

# ==========================================================
# SUPABASE EXCLUSIVO DEL BLOG
# Proyecto nuevo: eniscaicedo123
# ==========================================================
NEXT_PUBLIC_BLOG_SUPABASE_URL=https://nsjriyfebnwoovlkhga.supabase.co

# Clave publica del proyecto NUEVO del blog.
# Use preferiblemente la Publishable key nueva.
NEXT_PUBLIC_BLOG_SUPABASE_PUBLISHABLE_KEY=
# Legacy opcional si el proyecto no muestra Publishable key.
NEXT_PUBLIC_BLOG_SUPABASE_ANON_KEY=

# Clave SOLO de servidor del proyecto NUEVO del blog.
# NUNCA agregue NEXT_PUBLIC_ a esta variable.
BLOG_SUPABASE_SECRET_KEY=
# Legacy opcional si usa service_role.
BLOG_SUPABASE_SERVICE_ROLE_KEY=
