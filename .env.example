# IDX / ACOBIR RealtyServer
IDX_FTP_HOST=ftp.realtyserver.com
IDX_FTP_USER=
IDX_FTP_PASSWORD=
IDX_FTP_SECURE=false
IDX_FEEDS=res,com
IDX_ALLOWED_ZONES=Costa del Este,San Francisco,Obarrio,Bella Vista,Santa María
IDX_DOWNLOAD_PHOTOS=true
IDX_MAX_PHOTOS_PER_LISTING=12

# Debug opcional
IDX_FTP_VERBOSE=false
IDX_INCLUDE_RAW=false

# Control de fotos para GitHub Actions / sincronización larga
IDX_PHOTO_TIME_BUDGET_MINUTES=45
IDX_PHOTO_PROGRESS_EVERY=10
IDX_PHOTO_FETCH_TIMEOUT_MS=20000

# Supabase compartido por IDX + Blog
# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SITE_URL=https://eniscaicedo.com

# Clave publica: use preferiblemente la Publishable key nueva.
# Si su proyecto aun usa claves legacy, NEXT_PUBLIC_SUPABASE_ANON_KEY sigue soportada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave SOLO de servidor: use preferiblemente Secret key nueva.
# Si su proyecto aun usa claves legacy, SUPABASE_SERVICE_ROLE_KEY sigue soportada.
# NUNCA use prefijo NEXT_PUBLIC_ en estas claves.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bucket IDX existente (no cambiar si ya esta funcionando)
SUPABASE_STORAGE_BUCKET=idx-photos
